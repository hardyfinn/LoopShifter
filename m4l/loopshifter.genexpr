// Loopshifter for Max for Live: the gen~ engine (GenExpr, goes in a codebox).
//
// Capture a tempo-synced buffer (8, 16 or 32 beats). Then play a window of
// LOOP beats + SHIFT, jump forward by SHIFT, and repeat:
//     buffer ABCDEFGHIJKLMNOP, loop 4, shift 1  ->  ABCDE BCDEF CDEFG ...
// Each pass lasts exactly as long as the loop plus the jump, so the material
// stays on the beat whatever the shift is.
// Backwards (BACK): start on the last LOOP beats of the buffer, play LOOP - SHIFT,
// jump back by SHIFT:   MNO LMN KLM ...   (again on the beat).
//
// in1, in2: audio L, R
// in3: beat phase from [phasor~ 4n @lock 1] (not used, kept for later)
// in4: bar phase from [phasor~ 1n @lock 1] (capture and restart wait for a bar line)
// out1, out2: audio L, R
// out3: 1 while the loop is playing
//
// States: 0 empty, 1 capture armed, 2 recording, 3 ready (starts on the next bar),
//         4 playing, 5 stopped at the end of the buffer.
//
// Every History is copied into a local at the top and written back at the
// bottom. gen~ needs the function definitions first.

readAt(buf, pos, len) {
	i = pos - floor(pos / len) * len;
	return peek(buf, i, 0);
}

divBeats(i) {
	r = 1;
	if (i < 0.5) {
		r = 0.03125;
	} else if (i < 1.5) {
		r = 0.0625;
	} else if (i < 2.5) {
		r = 0.125;
	} else if (i < 3.5) {
		r = 0.25;
	} else if (i < 4.5) {
		r = 0.5;
	}
	return r;
}

// ---------------------------------------------------------------------------
Param bufbeats(16, min=4, max=32);     // buffer length in beats
Param loopbeats(4, min=1, max=16);     // loop length in beats
Param shiftmode(1, min=0, max=1);      // 0 = ms, 1 = note value
Param shiftdiv(5, min=0, max=5);       // 0..5 = 1/32 1/16 1/8 1/4 1/2 1 beat
Param shiftms(100, min=1, max=2000);   // shift in ms
Param dir(0, min=0, max=1);            // 0 = forward, 1 = back
Param fadems(20, min=0, max=40);       // crossfade at each jump
Param endmode(0, min=0, max=1);        // 0 = wrap, 1 = stop
Param tempo(120, min=20, max=999);     // Live's tempo
Param running(0, min=0, max=1);        // Live's transport is playing
Param capseq(0);                       // changes each time CAPTURE is pressed
Param rstseq(0);                       // changes each time RESTART is pressed

Data bufL(4194304);
Data bufR(4194304);
Buffer pk("lspk");                     // 512 peaks for the display, rebound to ---lspk
Buffer st("lsst");                     // state for the display, rebound to ---lsst

History h_state(0);
History h_pcap(0);
History h_prst(0);
History h_rstpend(0);
History h_wpos(0);
History h_len(0);
History h_cper(1);
History h_start(0);
History h_win(0);
History h_wl(0);
History h_wsh(0);
History h_wdir(0);
History h_pos(0);
History h_left(0);
History h_old(0);
History h_fade(0);
History h_flen(0);
History h_gain(0);
History h_pass(0);
History h_pph(0);
History h_prun(0);
History h_tick(0);
History h_gonext(0);
History h_still(0);
History h_since(1000000);
History h_cph(0);

// ---------------------------------------------------------------------------
PKN = 512;
sr = samplerate;

state = h_state;
rstpend = h_rstpend;
wpos = h_wpos;
len = h_len;
cper = h_cper;
start = h_start;
win = h_win;
wl = h_wl;
wsh = h_wsh;
wdir = h_wdir;
pos = h_pos;
left = h_left;
old = h_old;
fade = h_fade;
flen = h_flen;
gain = h_gain;
pass = h_pass;

ph = in4;
period = sr * 60 / tempo;
barStart = 0;
moving = 0;
still = 0;
since = 0;
tstart = 0;
stopped = 0;
cph = 0;
crossed = 0;
begin = 0;
gonext = 0;
wasPlaying = 0;
L = 0;
sh = 0;
nwin = 0;
nstart = 0;
k = 0;
b = 0;
mono = 0;
wetL = 0;
wetR = 0;
x = 0;
gn = 0;
go = 0;
ramp = 0;
target = 0;
size = dim(bufL);

// ---- Live's transport, read from the bar phasor ----
// The phasor stands still while Live is stopped, so the first sample it moves
// is the moment Live starts: an armed capture starts recording right there.
// (The "running" message from [transport] is a backup, it arrives up to 20 ms late.)
moving = abs(ph - h_pph) > 0.0000001;
still = h_still;
since = h_since;
tstart = 0;
if (moving) {
	if (still >= 0.01 * sr) {
		tstart = 1;
		since = 0;
	}
	still = 0;
} else {
	still = min(still + 1, sr);
}
if (running > 0.5 && h_prun < 0.5 && since > 0.1 * sr) {
	tstart = 1;
	since = 0;
}
since = min(since + 1, sr);
stopped = still >= 0.05 * sr || (running < 0.5 && since > 0.1 * sr);

// a bar line while Live plays
if (moving && ph < h_pph - 0.5) {
	barStart = 1;
}

// the capture point: the place in the bar where the buffer starts (0 = on the bar line).
// Ready and Restart begin when Live passes it, so the loop lines up with the bar as it was captured.
cph = h_cph;
crossed = 0;
if (moving) {
	if (ph >= h_pph) {
		crossed = h_pph < cph && ph >= cph;
	} else {
		crossed = cph > h_pph || cph <= ph;
	}
}
if (tstart > 0.5) {
	x = abs(ph - cph);
	if (min(x, 1 - x) < 0.01) {
		crossed = 1;
	}
}

// ---- buttons ----
if (capseq != h_pcap) {
	state = 1;
}
if (rstseq != h_prst && state >= 3) {
	rstpend = 1;
}

// ---- Live stopped: keep the buffer, start again from the top on the next play ----
if (stopped) {
	if (state == 2) {
		state = 1;
	} else if (state >= 4) {
		state = 3;
	}
}

// ---- capture: armed while Live is stopped -> starts with Live's Play;
//      pressed while Live plays -> waits for the next bar line ----
if (state == 1 && (tstart > 0.5 || barStart > 0.5)) {
	state = 2;
	cph = ph;
	wpos = 0;
	cper = floor(period + 0.5);
	len = min(floor(bufbeats + 0.5) * cper, size);
	for (k = 0; k < PKN; k += 1) {
		poke(pk, 0, k, 0);
	}
}
if (state == 2) {
	poke(bufL, in1, wpos, 0);
	poke(bufR, in2, wpos, 0);
	mono = max(abs(in1), abs(in2));
	b = floor(wpos * PKN / len);
	poke(pk, max(peek(pk, b, 0), mono), b, 0);
	wpos = wpos + 1;
	if (wpos >= len) {
		state = 3;          // the recording ends on the capture point: play from the next sample
		gonext = 1;
	}
}

// ---- ready / restart: begin when Live passes the capture point ----
if (state == 3 && (crossed > 0.5 || h_gonext > 0.5)) {
	begin = 1;
}
if (rstpend > 0.5 && state >= 4 && crossed > 0.5) {
	begin = 1;
}

// ---- the window for this pass, from the controls ----
L = floor(loopbeats + 0.5) * cper;
if (shiftmode > 0.5) {
	sh = floor(divBeats(floor(shiftdiv + 0.5)) * cper + 0.5);
} else {
	sh = floor(shiftms * sr / 1000 + 0.5);
}
sh = max(1, sh);
if (dir > 0.5) {
	sh = min(sh, L - 1);    // backwards plays LOOP - SHIFT, so SHIFT must be shorter than LOOP
	nwin = L - sh;
} else {
	nwin = L + sh;
}

if (begin > 0.5) {
	wasPlaying = state >= 4 && gain > 0.001;
	if (wasPlaying) {
		old = pos;
		flen = floor(fadems * sr / 1000);
		fade = flen;
	}
	if (dir > 0.5) {
		start = max(0, len - L);
	} else {
		start = 0;
	}
	pos = start;
	win = nwin;
	wl = L;
	wsh = sh;
	wdir = dir;
	left = win;
	pass = 1;
	state = 4;
	rstpend = 0;
}

// ---- end of a pass: jump by SHIFT ----
if (state == 4 && begin < 0.5 && left <= 0) {
	if (wdir > 0.5) {
		nstart = start - wsh;
	} else {
		nstart = start + wsh;
	}
	if (endmode > 0.5) {
		if (dir > 0.5) {
			if (nstart < 0) {
				state = 5;
			}
		} else if (nstart + nwin > len) {
			state = 5;
		}
	}
	if (state == 4) {
		nstart = nstart - floor(nstart / len) * len;
		flen = floor(fadems * sr / 1000);
		if (flen > 0) {
			old = pos;
			fade = flen;
		}
		start = nstart;
		pos = start;
		win = nwin;
		wl = L;
		wsh = sh;
		wdir = dir;
		left = win;
		pass = pass + 1;
	}
}

// ---- play ----
if ((state >= 4 || gain > 0) && len > 0) {
	wetL = readAt(bufL, pos, len);
	wetR = readAt(bufR, pos, len);
	if (fade > 0 && flen > 0) {
		x = 1 - fade / flen;
		gn = sin(x * halfpi);
		go = cos(x * halfpi);
		wetL = wetL * gn + readAt(bufL, old, len) * go;
		wetR = wetR * gn + readAt(bufR, old, len) * go;
		old = old + 1;
		fade = fade - 1;
	}
	pos = pos + 1;
	left = left - 1;
}

// ---- dry before and after the loop, wet while it plays ----
target = 0;
if (state == 4) {
	target = 1;
}
ramp = 1 / max(1, max(fadems, 2) * sr / 1000);
if (gain < target) {
	gain = min(target, gain + ramp);
} else if (gain > target) {
	gain = max(target, gain - ramp);
}
out1 = in1 * (1 - gain) + wetL * gain;
out2 = in2 * (1 - gain) + wetR * gain;
out3 = state == 4;

// ---- state for the display, about 200 times a second ----
if (h_tick <= 0) {
	poke(st, state, 0, 0);
	poke(st, len, 1, 0);
	poke(st, start, 2, 0);
	poke(st, win, 3, 0);
	poke(st, pos - floor(pos / max(1, len)) * max(1, len), 4, 0);
	poke(st, pass, 5, 0);
	poke(st, sr, 6, 0);
	poke(st, cper, 7, 0);
	poke(st, wpos, 8, 0);
	poke(st, wdir, 9, 0);
	poke(st, wl, 10, 0);
	poke(st, wsh, 11, 0);
	poke(st, period, 12, 0);
	poke(st, endmode, 13, 0);
	poke(st, rstpend, 14, 0);
	poke(st, gain, 15, 0);
	poke(st, shiftmode, 16, 0);
	poke(st, stopped, 17, 0);
	h_tick = floor(sr / 200);
} else {
	h_tick = h_tick - 1;
}

// ---- write the state back ----
h_state = state;
h_pcap = capseq;
h_prst = rstseq;
h_rstpend = rstpend;
h_wpos = wpos;
h_len = len;
h_cper = cper;
h_start = start;
h_win = win;
h_wl = wl;
h_wsh = wsh;
h_wdir = wdir;
h_pos = pos;
h_left = left;
h_old = old;
h_fade = fade;
h_flen = flen;
h_gain = gain;
h_pass = pass;
h_pph = ph;
h_prun = running;
h_gonext = gonext;
h_still = still;
h_since = since;
h_cph = cph;
